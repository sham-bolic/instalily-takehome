{
  "name": "instalily-takehome",
  "private": true,
  "type": "module",
  "scripts": {
    "event-sourcing": "node --env-file=.env backend/event-sourcing.ts",
    "company-sourcing": "node --env-file=.env backend/company-sourcing.ts",
    "company-enrichment": "node --env-file=.env backend/company-enrichment.ts",
    "decision-makers": "node --env-file=.env backend/decision-maker-pipeline.ts",
    "outreach": "node --env-file=.env backend/outreach-pipeline.ts",
    "pipeline": "node --env-file=.env backend/pipeline.ts",
    "dashboard": "next dev -p ${PORT:-4173}",
    "build": "next build",
    "start": "next start -p ${PORT:-4173}",
    "db:inspect": "node backend/inspect-pipeline.ts",
    "test": "node --test test/*.test.ts",
    "test:e2e": "npm run build && node --test e2e/**/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.44",
    "@tavily/core": "0.7.7",
    "ai": "7.0.66",
    "next": "^16.3.1",
    "playwright": "^1.62.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "5.9.3"
  }
}
